{
  "hosting": {
    "site": "kharis-app-admin",
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "Dockerfile", "docker-compose.yml"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
