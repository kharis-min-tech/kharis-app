rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // No client has write access to content: branches, events, announcements,
    // live and the rest are managed in the Kharis Content Studio
    // (https://kharis-content.itadmin-a94.workers.dev, Supabase). The public
    // reads below serve what the app and Cloud Functions still keep in
    // Firestore; Cloud Functions write through the Admin SDK, which bypasses
    // these rules.

    // Helper: does `rsvpId` belong to the caller? RSVP document IDs are
    // `{uid}_{eventId}`, so the uid prefix is the ownership proof. Checking
    // the ID (rather than only `resource.data.userId`) means an existence
    // check on a document that does not exist still evaluates — there is no
    // `resource` to read for a missing doc.
    function ownsRsvpId(rsvpId) {
      let prefix = request.auth.uid + '_';
      return isAuthenticated()
             && rsvpId.size() > prefix.size()
             && rsvpId[0:prefix.size()] == prefix;
    }

    // users — each user manages their own profile. Nobody may set or change
    // `role` from a client (no self-promotion): a self-created profile starts
    // as a plain member role. A member may delete their own profile (in-app
    // account deletion).
    //
    // Keys are an allowlist of what the app writes (FirebaseAuthRepository
    // register/_upsertProfile/_hydrate/updateProfile/updateNotificationPrefs,
    // branch_provider, NotificationService._saveTokenToProfile), each
    // type-checked. A create is checked in full; an update only on the keys
    // it changes, so legacy profiles holding other keys (old Studio admin
    // fields, a Timestamp `dob`) stay editable. `dobMMDD` is the month-day
    // pushBirthdays queries on, and must match `dob`.
    function validProfile(data, keys) {
      return keys.hasOnly(['email', 'displayName', 'role', 'branch', 'photoUrl',
                           'phone', 'dob', 'dobMMDD', 'notificationPrefs',
                           'fcmToken', 'fcmTokenUpdatedAt', 'createdAt'])
        && (!keys.hasAny(['email']) || (data.email is string && data.email.size() <= 320))
        && (!keys.hasAny(['displayName'])
            || (data.displayName is string && data.displayName.size() <= 200))
        && (!keys.hasAny(['branch'])
            || data.branch == null || (data.branch is string && data.branch.size() <= 100))
        && (!keys.hasAny(['photoUrl'])
            || data.photoUrl == null
            || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && (!keys.hasAny(['phone'])
            || data.phone == null || (data.phone is string && data.phone.size() <= 40))
        && (!keys.hasAny(['dob'])
            || (data.dob is string && data.dob.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (!keys.hasAny(['dob', 'dobMMDD'])
            || !('dobMMDD' in data)
            || (data.dob is string && data.dob.size() == 10
                && data.dobMMDD == data.dob[5:10]))
        && (!keys.hasAny(['notificationPrefs'])
            || (data.notificationPrefs is map && data.notificationPrefs.size() <= 20))
        && (!keys.hasAny(['fcmToken'])
            || (data.fcmToken is string && data.fcmToken.size() > 0
                && data.fcmToken.size() <= 4096))
        && (!keys.hasAny(['fcmTokenUpdatedAt']) || data.fcmTokenUpdatedAt is timestamp)
        && (!keys.hasAny(['createdAt']) || data.createdAt is timestamp);
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated() && request.auth.uid == uid
                    && request.resource.data.role in ['member', 'guest', 'new_here']
                    && validProfile(request.resource.data, request.resource.data.keys());
      allow update: if isAuthenticated() && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role'])
                    && validProfile(request.resource.data,
                                    request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isAuthenticated() && request.auth.uid == uid;

      // notes — the member's private notebook. Owner-only: nobody else, not
      // even an admin, may read what a member wrote. Anchored notes also
      // carry sermonId / positionMs, both optional.
      match /notes/{noteId} {
        function isOwner() {
          return isAuthenticated() && request.auth.uid == uid;
        }
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
                              && request.resource.data.body is string
                              && request.resource.data.body.size() > 0
                              && request.resource.data.body.size() <= 20000
                              && request.resource.data.updatedAt is timestamp;
      }

      // playlists — member-created named lists of sermon ids. Owner-only,
      // like notes: nobody else, not even an admin, may read or change them.
      // Shape mirrors PlaylistRepository: `name` (trimmed client-side,
      // 1..80 chars), `sermonIds` (list of catalogue ids — entries may
      // dangle when a message leaves the library, resolution tolerates
      // that), and `createdAt`/`updatedAt` timestamps. `request.resource.data`
      // is the full post-write document, so updates (rename, arrayUnion /
      // arrayRemove of sermon ids) are held to the same shape as creates.
      match /playlists/{playlistId} {
        function isOwner() {
          return isAuthenticated() && request.auth.uid == uid;
        }
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 80
                              && request.resource.data.sermonIds is list
                              && request.resource.data.createdAt is timestamp
                              && request.resource.data.updatedAt is timestamp;
      }
    }

    // Public, read-only content. `branches` (venue-change and service-reminder
    // pushes), `events` (website import by syncWebsiteEvents), `news`
    // (announcement pushes), `sermons` (syncYouTube mirrors; the app reads
    // hand-added and starred ones), `config` (`featured` mode for the Messages
    // carousel). `dailyContent` and `readingPlans` are legacy: today's reading
    // now comes from the Content Studio, and nothing reads them any more.
    match /branches/{branchId} {
      allow read: if true;
    }

    match /sermons/{sermonId} {
      allow read: if true;
    }

    match /events/{eventId} {
      allow read: if true;
    }

    match /dailyContent/{dateId} {
      allow read: if true;
    }

    match /readingPlans/{planId} {
      allow read: if true;
    }

    // dailyReadingPushes — one document per date the daily reading notification
    // has been claimed for. Written only by the Admin SDK (which bypasses these
    // rules) and it is the ONLY guard against double-sending, so a client able
    // to write it could duplicate or suppress a push to the whole church.
    match /dailyReadingPushes/{dateId} {
      allow read, write: if false;
    }

    match /news/{newsId} {
      allow read: if true;
    }

    match /config/{docId} {
      allow read: if true;
    }

    // app_feedback — in-app rating (1-5) + optional comment from the feedback
    // sheet. Any signed-in member (anonymous included) may write feedback
    // attributed to themselves; no client reads it back. Keys are closed so a
    // client cannot smuggle extra fields.
    //
    // One doc per user per UTC day: the id must be `{uid}_{yyyymmdd}` for the
    // day of the write (request.time), so a scripted account can add at most
    // one doc a day. A second submission that day overwrites the first.
    function feedbackDayId() {
      let t = request.time;
      return request.auth.uid + '_' + string(t.year())
             + (t.month() < 10 ? '0' : '') + string(t.month())
             + (t.day() < 10 ? '0' : '') + string(t.day());
    }

    match /app_feedback/{feedbackId} {
      allow create, update: if isAuthenticated()
                    && feedbackId == feedbackDayId()
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'rating', 'comment', 'source', 'platform', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 2000
                    && request.resource.data.source in ['prompt', 'settings']
                    && request.resource.data.platform is string
                    && request.resource.data.platform.size() <= 20
                    && request.resource.data.createdAt == request.time;
    }

    // rsvps — one doc per user+event, ID `{uid}_{eventId}`. Ownership is bound
    // to the document ID as well as the payload, so a member can never create,
    // read or delete another member's RSVP.
    match /rsvps/{rsvpId} {
      allow get: if ownsRsvpId(rsvpId);
      // Listing is only ever allowed for a query already narrowed to the
      // caller's own RSVPs.
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.eventId is string
                    && request.resource.data.eventId.size() > 0
                    && rsvpId == request.auth.uid + '_' + request.resource.data.eventId;
      // RSVPs are create-or-delete only; there is nothing to mutate in place.
      allow update: if false;
      allow delete: if ownsRsvpId(rsvpId);
    }

    // pushLog and pushState — push bookkeeping (`push-state.ts`): one claim
    // per FCM notification the Content Studio pollers have sent, and the
    // snapshots and checkpoints they compare against. Written only by the
    // Admin SDK (which bypasses these rules). Nothing client-side reads them,
    // and a client that could write them could suppress or repeat real
    // pushes, so both are closed to everyone.
    match /pushLog/{pushKey} {
      allow read, write: if false;
    }

    match /pushState/{stateKey} {
      allow read, write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
