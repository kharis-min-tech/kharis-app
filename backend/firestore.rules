rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: admin via custom claim OR a profile role of 'admin'.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Helper: does `rsvpId` belong to the caller? RSVP document IDs are
    // `{uid}_{eventId}`, so the uid prefix is the ownership proof. Checking
    // the ID (rather than only `resource.data.userId`) means an existence
    // check on a document that does not exist still evaluates — there is no
    // `resource` to read for a missing doc.
    function ownsRsvpId(rsvpId) {
      let prefix = request.auth.uid + '_';
      return isAuthenticated()
             && rsvpId.size() > prefix.size()
             && rsvpId[0:prefix.size()] == prefix;
    }

    // users — each user manages their own profile; admins manage all profiles
    // and are the only ones who may change a role (no self-promotion).
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == uid
                    && request.resource.data.role in ['member', 'guest', 'new_here'];
      allow update: if isAdmin()
                    || (isAuthenticated() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // branches — publicly readable, writable only by admin
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // sermons — publicly readable, writable only by admin
    match /sermons/{sermonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // events — publicly readable, writable only by admin
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // dailyContent — publicly readable, writable only by admin
    match /dailyContent/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // news — publicly readable, writable only by admin
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // config (e.g. live status, featured video) — publicly readable, admin writable
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // visitors — anyone may submit (create), only admins may read/manage
    match /visitors/{visitorId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    // testimonies — anyone may submit (create), only admins may read/manage
    match /testimonies/{testimonyId} {
      allow create: if request.resource.data.keys().hasAll(['text', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // rsvps — one doc per user+event, ID `{uid}_{eventId}`. Ownership is bound
    // to the document ID as well as the payload, so a member can never create,
    // read or delete another member's RSVP.
    match /rsvps/{rsvpId} {
      allow get: if ownsRsvpId(rsvpId) || isAdmin();
      // Listing is only ever allowed for a query already narrowed to the
      // caller's own RSVPs; admins may list everything.
      allow list: if isAdmin()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.eventId is string
                    && request.resource.data.eventId.size() > 0
                    && rsvpId == request.auth.uid + '_' + request.resource.data.eventId;
      // RSVPs are create-or-delete only; there is nothing to mutate in place.
      allow update: if false;
      allow delete: if ownsRsvpId(rsvpId) || isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
