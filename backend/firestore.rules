rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: user has admin custom claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // sermons — publicly readable, writable only by admin
    match /sermons/{sermonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // events — publicly readable, writable only by admin
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // dailyContent — publicly readable, writable only by admin
    match /dailyContent/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // news — publicly readable, writable only by admin
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // config (e.g. live status) — publicly readable, admin writable
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // visitors — anyone may submit (create), only admins may read/manage
    match /visitors/{visitorId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    // testimonies — anyone may submit (create), only admins may read/manage
    match /testimonies/{testimonyId} {
      allow create: if request.resource.data.keys().hasAll(['text', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
