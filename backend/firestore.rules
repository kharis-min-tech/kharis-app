rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Roles (see backend/SETUP.md "Admins"):
    //   - super admin: custom claim `admin == true` OR `users/{uid}.role ==
    //     'admin'`. Manages everything below that admins may write.
    //   - campus admin: `users/{uid}.role == 'campus_admin'` with
    //     `adminBranchIds` (branch doc ids) and `adminBranchNames` (the
    //     matching branch names — news/events `branch` holds the NAME, branch
    //     docs are keyed by id, hence both lists). Manages only the news and
    //     events of those campuses and the non-identity fields of those branch
    //     docs. Never all-campus content, config, or other collections.
    // Only super admins assign roles and campus lists (see users below).

    // Helper: the caller's own profile doc.
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: super admin via custom claim OR a profile role of 'admin'.
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          callerProfile().data.role == 'admin'
        )
      );
    }

    // Helper: campus admin — a profile role of 'campus_admin'. What they may
    // touch is bounded by their adminBranchIds / adminBranchNames lists.
    function isCampusAdmin() {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && callerProfile().data.role == 'campus_admin';
    }

    // Helper: the caller is a campus admin of the campus NAMED `name` (the
    // `branch` value of a news/events doc). A null or blank name is
    // all-campus content, which no campus admin manages.
    function managesCampusNamed(name) {
      return isCampusAdmin()
             && name is string
             && name.trim().size() > 0
             && name in callerProfile().data.get('adminBranchNames', []);
    }

    // Helper: the caller is a campus admin of the branch doc `branchId`.
    function managesBranchId(branchId) {
      return isCampusAdmin()
             && branchId in callerProfile().data.get('adminBranchIds', []);
    }

    // Helper: does `rsvpId` belong to the caller? RSVP document IDs are
    // `{uid}_{eventId}`, so the uid prefix is the ownership proof. Checking
    // the ID (rather than only `resource.data.userId`) means an existence
    // check on a document that does not exist still evaluates — there is no
    // `resource` to read for a missing doc.
    function ownsRsvpId(rsvpId) {
      let prefix = request.auth.uid + '_';
      return isAuthenticated()
             && rsvpId.size() > prefix.size()
             && rsvpId[0:prefix.size()] == prefix;
    }

    // Helper: `branch` is absent, null or a string — the campus scope used by
    // news and events. Absent/null/blank all mean all-campus.
    function optionalCampus(data) {
      return !('branch' in data) || data.branch == null || data.branch is string;
    }

    // Helper: the caller is a campus admin of the campus a news/events doc
    // (`data`) is scoped to.
    function managesCampusOf(data) {
      return managesCampusNamed(data.get('branch', null));
    }

    // Helper: optional `field` is absent, null, or a string of at most `max`.
    function optionalText(data, field, max) {
      return !(field in data) || data[field] == null
             || (data[field] is string && data[field].size() <= max);
    }

    // Helper: optional `field` is absent, null, or an http/https URL string.
    function optionalHttpUrl(data, field) {
      return !(field in data) || data[field] == null
             || (data[field] is string
                 && data[field].matches('[Hh][Tt][Tt][Pp][Ss]?://.+'));
    }

    // Helper: giving details — `config/giving` and `branches.giving` share
    // {url?, bankName?, accountName?, sortCode?, accountNumber?, swiftBic?,
    // iban?, reference?, note?}. Every field optional; `url` must be http/https.
    function givingShape(giving) {
      return giving is map
             && optionalHttpUrl(giving, 'url')
             && optionalText(giving, 'bankName', 200)
             && optionalText(giving, 'accountName', 200)
             && optionalText(giving, 'sortCode', 50)
             && optionalText(giving, 'accountNumber', 50)
             && optionalText(giving, 'reference', 200)
             && optionalText(giving, 'swiftBic', 50)
             && optionalText(giving, 'iban', 50)
             && optionalText(giving, 'note', 2000);
    }

    // Helper: a Home layout — `config/home` and `branches.home` share
    // {sections: [{id, enabled}]} (ordered Home blocks).
    function homeShape(home) {
      return home is map && 'sections' in home && home.sections is list;
    }

    // Helper: a branch doc's optional `giving` / `home` are well-formed.
    // Absent or null means the campus falls back to the church-wide
    // `config/giving` / `config/home`.
    function branchShape(data) {
      return (!('giving' in data) || data.giving == null || givingShape(data.giving))
             && (!('home' in data) || data.home == null || homeShape(data.home));
    }

    // users — each user manages their own profile; super admins manage all
    // profiles and are the only ones who may set `role`, `adminBranchIds` or
    // `adminBranchNames` (no self-promotion, no self-assigned campuses). A
    // self-created profile starts as a plain member role with no campus lists.
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.auth.uid == uid
                    && request.resource.data.role in ['member', 'guest', 'new_here']
                    && !request.resource.data.keys().hasAny(['adminBranchIds', 'adminBranchNames']);
      allow update: if isSuperAdmin()
                    || (isAuthenticated() && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'adminBranchIds', 'adminBranchNames']));
      allow delete: if isSuperAdmin();

      // notes — the member's private notebook. Owner-only: nobody else, not
      // even an admin, may read what a member wrote. Anchored notes also
      // carry sermonId / positionMs, both optional.
      match /notes/{noteId} {
        function isOwner() {
          return isAuthenticated() && request.auth.uid == uid;
        }
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
                              && request.resource.data.body is string
                              && request.resource.data.body.size() > 0
                              && request.resource.data.body.size() <= 20000
                              && request.resource.data.updatedAt is timestamp;
      }

      // playlists — member-created named lists of sermon ids. Owner-only,
      // like notes: nobody else, not even an admin, may read or change them.
      // Shape mirrors PlaylistRepository: `name` (trimmed client-side,
      // 1..80 chars), `sermonIds` (list of catalogue ids — entries may
      // dangle when a message leaves the library, resolution tolerates
      // that), and `createdAt`/`updatedAt` timestamps. `request.resource.data`
      // is the full post-write document, so updates (rename, arrayUnion /
      // arrayRemove of sermon ids) are held to the same shape as creates.
      match /playlists/{playlistId} {
        function isOwner() {
          return isAuthenticated() && request.auth.uid == uid;
        }
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 80
                              && request.resource.data.sermonIds is list
                              && request.resource.data.createdAt is timestamp
                              && request.resource.data.updatedAt is timestamp;
      }
    }

    // branches — publicly readable. Super admins create, update and delete.
    // A campus admin may update only their own branch docs (id in
    // adminBranchIds) and never its identity/visibility fields — `name`,
    // `order`, `group`, `isActive` — so they edit contact, services, venues,
    // giving, home layout and the like, nothing that renames, reorders or
    // hides a campus. Optional `giving` and `home` are shape-checked for
    // every writer.
    match /branches/{branchId} {
      allow read: if true;
      allow create: if isSuperAdmin() && branchShape(request.resource.data);
      allow update: if branchShape(request.resource.data)
                    && (isSuperAdmin()
                        || (managesBranchId(branchId)
                            && !request.resource.data.diff(resource.data).affectedKeys()
                                  .hasAny(['name', 'order', 'group', 'isActive'])));
      allow delete: if isSuperAdmin();
    }

    // sermons — publicly readable, writable only by super admin
    match /sermons/{sermonId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // events — publicly readable, writable by super admins and by a campus
    // admin for their own campuses. `branch` scopes an event to one campus;
    // absent, null or blank means all-campus (every reader treats the three
    // alike) and is super-admin only. A campus admin's write must leave the
    // event on one of their campuses — both the stored and the new `branch`
    // are checked, so they cannot move one onto another campus.
    // `events/web_*` docs are imported from kharis.org by syncWebsiteEvents
    // through the Admin SDK (which bypasses these rules).
    match /events/{eventId} {
      allow read: if true;
      allow create: if (isSuperAdmin() || managesCampusOf(request.resource.data))
                    && optionalCampus(request.resource.data)
                    && optionalText(request.resource.data, 'address', 300);
      allow update: if (isSuperAdmin()
                        || (managesCampusOf(resource.data)
                            && managesCampusOf(request.resource.data)))
                    && optionalCampus(request.resource.data)
                    && optionalText(request.resource.data, 'address', 300);
      allow delete: if isSuperAdmin() || managesCampusOf(resource.data);
    }

    // dailyContent — publicly readable, writable only by super admin
    match /dailyContent/{dateId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // readingPlans — a plan authored once that spans a date range and resolves a
    // reading for every date inside it (see functions/src/reading-plans.ts).
    // Publicly readable because the app resolves the day's reading from the plan
    // itself whenever the API is unreachable. Writes are super-admin-only AND
    // shape-checked: a plan missing `startDate`/`book`/`days` silently drops out of
    // resolution, so it is rejected at write time rather than lost at read time.
    match /readingPlans/{planId} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
                    && request.resource.data.startDate is string
                    && request.resource.data.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.book is string
                    && request.resource.data.book.size() > 0
                    && request.resource.data.days is number
                    && request.resource.data.days >= 1
                    && request.resource.data.days <= 400;
      allow delete: if isSuperAdmin();
    }

    // dailyReadingPushes — one document per date the daily reading notification
    // has been claimed for. Written only by the Admin SDK (which bypasses these
    // rules) and it is the ONLY guard against double-sending, so a client able
    // to write it could duplicate or suppress a push to the whole church.
    match /dailyReadingPushes/{dateId} {
      allow read, write: if false;
    }

    // news (announcements) — publicly readable, writable by super admins and
    // by a campus admin for their own campuses (same campus rule as events:
    // stored and new `branch` both theirs; all-campus is super-admin only).
    // `branch` scopes an announcement to one campus; absent or null means
    // all-campus. Anything else would silently drop out of the branch-scoped
    // getAnnouncements query, so writes are rejected rather than lost.
    // Optional `eventId` (an events doc the notice promotes), `linkUrl`
    // (http/https) and `ctaLabel` (its button text) are shape-checked too.
    match /news/{newsId} {
      allow read: if true;
      allow create: if (isSuperAdmin() || managesCampusOf(request.resource.data))
                    && optionalCampus(request.resource.data)
                    && optionalText(request.resource.data, 'eventId', 200)
                    && optionalText(request.resource.data, 'ctaLabel', 24)
                    && optionalHttpUrl(request.resource.data, 'linkUrl');
      allow update: if (isSuperAdmin()
                        || (managesCampusOf(resource.data)
                            && managesCampusOf(request.resource.data)))
                    && optionalCampus(request.resource.data)
                    && optionalText(request.resource.data, 'eventId', 200)
                    && optionalText(request.resource.data, 'ctaLabel', 24)
                    && optionalHttpUrl(request.resource.data, 'linkUrl');
      allow delete: if isSuperAdmin() || managesCampusOf(resource.data);
    }

    // config — publicly readable, super-admin writable. Docs:
    //   - `live`: live status.
    //   - `featured`: {mode: 'auto'|'pinned'|'off', setAt} — how the Messages
    //     tab picks its featured carousel ('off' hides it; missing = 'auto').
    //   - `giving`: church-wide giving details, same shape as
    //     `branches.giving` (missing = the app's built-in details).
    //   - `home`: church-wide default Home layout {sections: [{id, enabled}]},
    //     same shape as `branches.home` (missing = the app's built-in order).
    match /config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin()
                   && (request.resource == null
                       || ((docId != 'featured'
                            || request.resource.data.mode in ['auto', 'pinned', 'off'])
                           && (docId != 'giving' || givingShape(request.resource.data))
                           && (docId != 'home' || homeShape(request.resource.data))));
    }

    // visitors — anyone may submit (create), only super admins may read/manage
    match /visitors/{visitorId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200;
      allow read, update, delete: if isSuperAdmin();
    }

    // testimonies — anyone may submit (create), only super admins may read/manage
    match /testimonies/{testimonyId} {
      allow create: if request.resource.data.keys().hasAll(['text', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000;
      allow read, update, delete: if isSuperAdmin();
    }

    // app_feedback — in-app rating (1-5) + optional comment from the feedback
    // sheet. Any signed-in member (anonymous included) may create one doc
    // attributed to themselves; only super admins may read or manage. Keys are
    // closed so a client cannot smuggle extra fields.
    match /app_feedback/{feedbackId} {
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'rating', 'comment', 'source', 'platform', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 2000
                    && request.resource.data.source in ['prompt', 'settings']
                    && request.resource.data.platform is string
                    && request.resource.data.platform.size() <= 20
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isSuperAdmin();
    }

    // rsvps — one doc per user+event, ID `{uid}_{eventId}`. Ownership is bound
    // to the document ID as well as the payload, so a member can never create,
    // read or delete another member's RSVP.
    match /rsvps/{rsvpId} {
      allow get: if ownsRsvpId(rsvpId) || isSuperAdmin();
      // Listing is only ever allowed for a query already narrowed to the
      // caller's own RSVPs; super admins may list everything.
      allow list: if isSuperAdmin()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.eventId is string
                    && request.resource.data.eventId.size() > 0
                    && rsvpId == request.auth.uid + '_' + request.resource.data.eventId;
      // RSVPs are create-or-delete only; there is nothing to mutate in place.
      allow update: if false;
      allow delete: if ownsRsvpId(rsvpId) || isSuperAdmin();
    }

    // notifications — Studio pushes (see functions/src/notifications.ts).
    // Clients write only `draft`, `scheduled` (with `sendAt`; "Send now" is
    // `sendAt == request.time`) and `cancelled` (from draft/scheduled). The
    // Admin SDK moves a due doc to `sending` -> `sent`/`failed` and alone
    // writes `sentAt` and `result`, so keys are closed to clients.
    // Audience: super admins any; a campus (branch) admin only one of their
    // own branches, or `test` (staff devices) — for both the stored and the
    // new doc, so they cannot take over or retarget anyone else's push.
    // Members read only what was actually sent to everyone or a branch, so the
    // app inbox query must constrain on `status == 'sent'` and audience type.
    function notificationAudienceShape(a) {
      return a is map
             && (((a.type == 'all' || a.type == 'test') && a.keys().hasOnly(['type']))
                 || (a.type == 'branch'
                     && a.keys().hasOnly(['type', 'branch'])
                     && a.branch is string
                     && a.branch.trim().size() > 0));
    }

    function managesNotificationAudience(a) {
      return isSuperAdmin()
             || (a.type == 'branch' && managesCampusNamed(a.branch))
             || (a.type == 'test'
                 && isCampusAdmin()
                 && callerProfile().data.get('adminBranchNames', []).size() > 0);
    }

    function notificationShape(d) {
      return d.keys().hasOnly(['title', 'body', 'link', 'audience', 'status', 'sendAt',
                               'createdAt', 'createdBy', 'createdByName', 'updatedAt'])
             && d.title is string && d.title.trim().size() > 0 && d.title.size() <= 65
             && d.body is string && d.body.trim().size() > 0 && d.body.size() <= 240
             && (!('link' in d) || d.link == null
                 || (d.link is string && d.link.size() <= 500
                     && d.link.matches('(/[^/].*|[Hh][Tt][Tt][Pp][Ss]?://.+)')))
             && notificationAudienceShape(d.audience)
             && d.status in ['draft', 'scheduled', 'cancelled']
             && (d.status != 'scheduled' || d.sendAt is timestamp)
             && (!('sendAt' in d) || d.sendAt == null || d.sendAt is timestamp)
             && d.createdAt is timestamp
             && d.createdBy is string
             && optionalText(d, 'createdByName', 200)
             && d.updatedAt is timestamp;
    }

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
                  || isCampusAdmin()
                  || (resource.data.status == 'sent'
                      && resource.data.audience.type in ['all', 'branch']);
      allow create: if notificationShape(request.resource.data)
                    && request.resource.data.status in ['draft', 'scheduled']
                    && request.resource.data.createdBy == request.auth.uid
                    && managesNotificationAudience(request.resource.data.audience);
      allow update: if resource.data.status in ['draft', 'scheduled']
                    && notificationShape(request.resource.data)
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.createdAt == resource.data.createdAt
                    && managesNotificationAudience(resource.data.audience)
                    && managesNotificationAudience(request.resource.data.audience);
      allow delete: if false;
    }

    // pushLog — one document per FCM notification the Firestore triggers in
    // `content-notifications.ts` have sent, keyed on the CloudEvent id. It is
    // written only by the Admin SDK (which bypasses these rules) and exists
    // purely so a redelivered trigger cannot double-send. Nothing client-side
    // reads it, and a client that could write it could suppress real pushes,
    // so it is closed to everyone — admins included.
    match /pushLog/{pushKey} {
      allow read, write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
