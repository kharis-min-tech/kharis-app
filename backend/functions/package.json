{
  "name": "kharis-functions",
  "description": "Firebase Cloud Functions for Kharis Church app",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\"",
    "test:rules": "tsc -p tsconfig.test.json && firebase emulators:exec --only firestore --project demo-kharis-rules \"node --test .test-build/test/rules/*.test.js\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "^12.19.0",
    "typescript": "^5.4.5"
  },
  "private": true
}
